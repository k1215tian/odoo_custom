<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.asset.group View List -->
    <record id="view_account_asset_group_list" model="ir.ui.view">
        <field name="name">view.account.asset.group.list</field>
        <field name="model">account.asset.group</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- View account.asset.group form -->
    <record id="view_account_asset_group_form" model="ir.ui.view">
        <field name="name">view.account.asset.group.form</field>
        <field name="model">account.asset.group</field>
        <field name="arch" type="xml">
            <form string="Account Asset Group">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Name..."/>
                        </h1>
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <!-- View account.asset.group search -->
    <record id="view_account_asset_group_search" model="ir.ui.view">
        <field name="name">view.account.asset.group.search</field>
        <field name="model">account.asset.group</field>
        <field name="arch" type="xml">
            <search>
                <group expand="1" string="Group By">
                    <filter string="Name" name="name" domain="[]" context="{'group_by':'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action account.asset.group -->
    <record id="action_account_asset_group" model="ir.actions.act_window">
        <field name="name">Account Asset Group</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.group</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[]</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                There is no examples click here to add new Account Asset Group.
            </p>
        </field>
    </record>

</odoo>
