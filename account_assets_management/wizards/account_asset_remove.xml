<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View account.asset.remove form -->
    <record id="view_account_asset_remove_form" model="ir.ui.view">
        <field name="name">view.account.asset.remove.form</field>
        <field name="model">account.asset.remove</field>
        <field name="arch" type="xml">
            <form string="Account Asset Remove">
                <div class="oe_title">
                    <label for="name"/>
                    <h1>
                        <field name="name" placeholder="Name..."/>
                    </h1>
                </div>
                <footer>
                    <button name="add" type="object" string="Add" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action account.asset.remove -->
    <record id="action_account_asset_remove" model="ir.actions.act_window">
        <field name="name">Account Asset Remove</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.asset.remove</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="addon.model_model_name"/>
        <field name="target">new</field>
    </record>

</odoo>
