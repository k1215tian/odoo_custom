<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View asset.modify form -->
    <record id="view_asset_modify_form" model="ir.ui.view">
        <field name="name">view.asset.modify.form</field>
        <field name="model">asset.modify</field>
        <field name="arch" type="xml">
            <form string="Asset Modify">
                <div class="oe_title">
                    <label for="name"/>
                    <h1>
                        <field name="name" placeholder="Name..."/>
                    </h1>
                </div>
                <footer>
                    <button name="add" type="object" string="Add" class="oe_highlight"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action asset.modify -->
    <record id="action_asset_modify" model="ir.actions.act_window">
        <field name="name">Asset Modify</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">asset.modify</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="addon.model_model_name"/>
        <field name="target">new</field>
    </record>

</odoo>
