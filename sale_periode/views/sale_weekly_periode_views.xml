<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_weekly_period_list" model="ir.ui.view">
        <field name="name">sale.weekly.period.list</field>
        <field name="model">sale.weekly.periode</field>
        <field name="arch" type="xml">
            <list string="Weekly Periods" default_order="years desc,start_date asc" multi_edit="1">
                <field name="code" readonly="1"/>
                <field name="name" readonly="1"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="years" readonly="1"/>
                <field name="month" readonly="1"/>
                <field name="week_no" readonly="1"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_sale_weekly_period_form" model="ir.ui.view">
        <field name="name">sale.weekly.period.form</field>
        <field name="model">sale.weekly.periode</field>
        <field name="arch" type="xml">
            <form string="Weekly Period" readonly="1">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Weekly Period Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Period Information">
                            <field name="code" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="years"/>
                            <field name="month"/>
                            <field name="week_no"/>
                        </group>
                        <group string="Date Range">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sale_weekly_period_search" model="ir.ui.view">
        <field name="name">sale.weekly.period.search</field>
        <field name="model">sale.weekly.periode</field>
        <field name="arch" type="xml">
            <search string="Search Weekly Period">
                <field name="code"/>
                <field name="name"/>
                <field name="years"/>
                <field name="month"/>
                <field name="week_no"/>
                <field name="company_id"/>

                <filter string="Active" name="filter_active" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="filter_archived" domain="[('active', '=', False)]"/>

                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}"/>
                    <filter string="Year" name="group_year" context="{'group_by': 'years'}"/>
                    <filter string="Month" name="group_month" context="{'group_by': 'month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sale_weekly_period" model="ir.actions.act_window">
        <field name="name">Weekly Periods</field>
        <field name="res_model">sale.weekly.periode</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'active_test': False, 'search_default_group_year': 1}</field>
        <field name="search_view_id" ref="view_sale_weekly_period_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create Weekly Sales Period
            </p>
            <p>
                Weekly periods are used for sales reporting and analysis.
            </p>
        </field>
    </record>

    <menuitem id="menu_sale_weekly_period_root" name="Weekly Periods" parent="sales_team.menu_sale_config" sequence="99"/>
    <menuitem id="menu_sale_weekly_period" name="Weekly Period" parent="menu_sale_weekly_period_root" action="action_sale_weekly_period" sequence="1"/>

</odoo>