<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_generate_weekly_period" model="ir.cron">
            <field name="name">Generate Weekly Period</field>
            <field name="model_id" ref="model_sale_weekly_periode"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_weekly_period()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall">2026-12-31 16:00:00</field>
            <field name="priority">5</field>
        </record>
        <record id="ir_cron_generate_quarterly_period" model="ir.cron">
            <field name="name">Generate Quarterly Period</field>
            <field name="model_id" ref="model_sale_quarterly_periode"/>
            <field name="state">code</field>
            <field name="code">model.cron_generate_quarterly_period()</field>
            <field name="active" eval="True"/>
            <field name="user_id" ref="base.user_root"/>
            <field name="interval_number">12</field>
            <field name="interval_type">months</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="nextcall">2026-12-31 16:00:00</field>
            <field name="priority">6</field>
        </record>
    </data>
</odoo>